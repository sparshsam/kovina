# HTML pages must never be cached — they reference hashed asset names that change per build
/*
  Cache-Control: public, no-cache
  CDN-Cache-Control: no-cache

# Hashed static assets are immutable — cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are versioned — cache long
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# App icons change rarely — cache moderately
/app-icons/*
  Cache-Control: public, max-age=86400
